+// Flash-MoE: Helper function to load active experts before graph execution
+// This should be called from llama_decode() after computing the router logits
+// but before executing the graph
+bool staged_moe_prepare_experts(
+        const llama_model & model,
+        const llama_hparams & hparams,
+        int layer_id,
+        const int32_t * selected_experts,  // Array of K expert IDs
+        int n_expert_used) {
+
+    if (!staged_moe_is_enabled()) {
+        return true;
+    }
+
+    staged_moe_manager* manager = get_staged_moe_manager();
+    if (!manager) {
+        return false;
+    }
+
+    // Load gate, up, and down experts for the selected IDs
+    for (int i = 0; i < n_expert_used; i++) {
+        int expert_id = selected_experts[i];
+
+        // Load gate expert
+        void* gate_data = manager->get_expert_data(layer_id, "gate", expert_id);
+        if (!gate_data) {
+            LLAMA_LOG_ERROR("Flash-MoE: Failed to load gate expert %d for layer %d\n", expert_id, layer_id);
+            return false;
+        }
+
+        // Load up expert
+        void* up_data = manager->get_expert_data(layer_id, "up", expert_id);
+        if (!up_data) {
+            LLAMA_LOG_ERROR("Flash-MoE: Failed to load up expert %d for layer %d\n", expert_id, layer_id);
+            return false;
+        }
+
+        // Load down expert
+        void* down_data = manager->get_expert_data(layer_id, "down", expert_id);
+        if (!down_data) {
+            LLAMA_LOG_ERROR("Flash-MoE: Failed to load down expert %d for layer %d\n", expert_id, layer_id);
+            return false;
+        }
+    }
+
+    static int total_preparations = 0;
+    total_preparations++;
+    if (total_preparations % 100 == 0) {
+        LLAMA_LOG_INFO("Flash-MoE: Prepared experts %d times\n", total_preparations);
+    }
+
+    return true;
+}
