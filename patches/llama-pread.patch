 //
+// Flash-MoE: Environment variable parsing
+//
+
+static void llama_parse_pread_env() {
+    const char* use_pread = getenv("LLAMA_USE_PREAD");
+    if (use_pread && (strcmp(use_pread, "1") == 0 || strcmp(use_pread, "true") == 0)) {
+        g_pread_config.use_pread = true;
+        LLAMA_LOG_INFO("%s: Flash-MoE pread() loading enabled\n", __func__);
+    }
+
+    const char* use_staging = getenv("LLAMA_USE_GPU_STAGING");
+    if (use_staging && (strcmp(use_staging, "1") == 0 || strcmp(use_staging, "true") == 0)) {
+        g_pread_config.use_gpu_staging = true;
+        LLAMA_LOG_INFO("%s: Flash-MoE GPU staging buffer enabled\n", __func__);
+    }
+
+    // staging_buffer_size can be set via LLAMA_STAGING_BUFFER_SIZE (in MB)
+    const char* staging_size = getenv("LLAMA_STAGING_BUFFER_SIZE");
+    if (staging_size) {
+        g_pread_config.staging_buffer_size = atoi(staging_size) * 1024 * 1024;
+    } else {
+        // Default: 6 experts * 24MB = 144MB
+        g_pread_config.staging_buffer_size = 6 * 24 * 1024 * 1024;
+    }
+}
